  "presence": [
    {
      "path": "(^|/)Dockerfile(\\.[^/]*)?$",
      "tool": "Docker"
    },
    {
      "path": "(^|/)(docker-)?compose\\.ya?ml$",
      "tool": "Docker"
    },
    {
      "path": "^\\.github/workflows/[^/]+\\.ya?ml$",
      "tool": "GitHub Actions"
    },
    {
      "path": "(^|/)package\\.xml$",
      "content": "ament|catkin",
      "tool": "ROS"
    },
    {
      "path": "\\.tf$",
      "tool": "Terraform"
    }
  ]
}
